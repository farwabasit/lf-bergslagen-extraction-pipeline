OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Centralized store for customer interaction history and Next Best Action
# (marketing offer) data - see backend/db.py. Point everyone running this
# app at the SAME hosted Postgres instance so the NBA engine learns from
# everyone's usage, not an isolated copy per laptop. A free-tier project on
# Neon (https://neon.tech) or Supabase (https://supabase.com) works fine -
# copy the "connection string" they give you here. Leave unset to fall back
# to a local SQLite file (backend/nba.db) for solo/offline use.
# DATABASE_URL=postgresql://user:password@host/dbname